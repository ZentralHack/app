      "criteria": [
        {
          "id": "frauenanteil_50",
          "text": "Die Gesuchstellerin ist Unternehmerin (Einzelfirma oder juristische Person). Das Unternehmen ist zu mindestens 50% in Frauenhand.",
          "kind": "muss",
          "about": "unternehmen",
          "applies_if": null,
          "profile_fields": [
            "frauenanteil_eigentum"
          ],
          "question": {
            "text": "Gehört Ihr Unternehmen mindestens zur Hälfte Frauen?",
            "options": [
              "Ja",
              "Nein",
              "Weiss nicht"
            ]
          },
          "evidence": [],
          "source": {
            "source_id": "buergschaften",
            "locator": "Voraussetzungen, Punkt 1"
          },
          "notes": "Die Bürgschaften-Seite sagt «zu mind. 50% in Frauenhand». Das PDF «Voraussetzungen» und die Statuten (Art. 2) sprechen von «von Frauen geführten Unternehmen»."
        },
        {
          "id": "sitz_schweiz",
          "text": "Sitz des Unternehmens in der Schweiz.",
          "kind": "muss",
          "about": "ort",
          "applies_if": null,
          "profile_fields": [
            "standort_kanton"
          ],
          "question": {
            "text": "Hat Ihr Unternehmen den Sitz in der Schweiz?",
            "options": [
              "Ja",
              "Nein",
              "Weiss nicht"
            ]
          },
          "evidence": [],
          "source": {
            "source_id": "buergschaften",
            "locator": "Voraussetzungen, Punkt 1"
          },
          "notes": null
        },
        {
          "id": "bankkredit_benoetigt",
          "text": "Es wird ein Bankkredit für die Gründung oder den Betrieb des Unternehmens benötigt.",
          "kind": "muss",
          "about": "partner",
          "applies_if": null,
          "profile_fields": [
            "partner",
            "budget"
          ],
          "question": {
            "text": "Brauchen Sie einen Bankkredit?",
            "options": [
              "Ja",
              "Nein",
              "Weiss nicht"
            ]
          },
          "evidence": [],
          "source": {
            "source_id": "buergschaften",
            "locator": "Voraussetzungen, Punkt 2"
          },
          "notes": null
        },
        {
          "id": "todesfallpolice",
          "text": "Die Bürgschaftsnehmerin schliesst eine Todesfallrisikoversicherung ab (bewilligter Bürgschaftsbetrag plus 20%, Mindestlaufzeit wie die Bürgschaft) und verpfändet die Police der finanzierenden Bank.",
          "kind": "muss",
          "about": "dokumente",
          "applies_if": null,
          "profile_fields": [],
          "question": {
            "text": "Sind Sie bereit, eine Todesfallrisikoversicherung abzuschliessen und der Bank zu verpfänden?",
            "options": [
              "Ja",
              "Nein",
              "Weiss nicht"
            ]
          },
          "evidence": [
            "Kopie der Police und des Pfandvertrags an die BG SAFFA"
          ],
          "source": {
            "source_id": "voraussetzungen_pdf",
            "locator": "Seite 1, Todesfallrisikoversicherung"
          },
          "notes": "Gilt bei Bewilligung (Bürgschaften-Seite, «Bei Bewilligung»). Die Gesuchstellerin anerkennt die Voraussetzungen mit ihrer Unterschrift als verbindlich."
        }
      ],
      "funding": {
        "model": "individuell",
        "summary": "Bürgschaft für einen Bankkredit bis CHF 1 Mio., Rückzahlung innert 10 Jahren.",
        "cost_categories": [],
        "units": [],
        "max_share_of_costs_pct": null,
        "min_amount_chf": null,
        "max_amount_chf": 1000000,
        "cofinancing": null,
        "deductions": [],
        "payout_forms": [
          "Verbürgung des Bankkredits"
        ],
        "calculation_basis": null,
        "example": null,
        "source": {
          "source_id": "buergschaften",
          "locator": "Voraussetzungen; Bei Bewilligung"
        },
        "note": "Einschreibegebühr CHF 300, nicht erstattbar. Gesuchsprüfungsgebühr bei Bewilligung 1.1% des verbürgten Betrags, max. CHF 3'000 (ab CHF 280'000 pauschal CHF 3'000). Jährliche Bürgschaftskommission 1.25% auf dem offenen Betrag, bei Inanspruchnahme durch die Bank derzeit 2.5%. Genossenschaftsanteil CHF 100."
      },
      "timing": {
        "deadline": {
