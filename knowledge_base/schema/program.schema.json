{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program.schema.json",
  "title": "Foerderprogramm",
  "description": "Ein Förderprogramm mit einem oder mehreren Instrumenten. Matching läuft pro Instrument. Unbekannte Werte sind null, nie geraten.",
  "type": "object",
  "required": ["id", "name", "provider", "level", "scope", "purpose", "entitlement", "instruments", "sources", "meta"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "short_name": { "type": ["string", "null"] },
    "provider": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] }
      }
    },
    "level": { "enum": ["bund", "kanton", "region", "gemeinde", "stiftung", "privat"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cantons": { "type": "array", "items": { "type": "string" } },
        "municipalities": { "type": "array", "items": { "type": "string" } },
        "note": { "type": ["string", "null"] }
      }
    },
    "purpose": { "type": "string" },
    "entitlement": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["rechtsanspruch_im_budget", "kein_rechtsanspruch", "wettbewerb"] },
        "note": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "budget": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "annual_chf": { "type": ["number", "null"] },
        "year": { "type": ["integer", "null"] },
        "oversubscription": { "enum": ["anteilige_kuerzung", "bis_budget_ausgeschoepft", "auswahl", "unbekannt"] },
        "note": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "general_criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
    "general_exclusions": { "type": "array", "items": { "$ref": "#/$defs/textWithSource" } },
    "instruments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/instrument" } },
    "combination_rules": { "type": "array", "items": { "$ref": "#/$defs/combinationRule" } },
    "application": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "channel": { "enum": ["online_portal", "email", "post", "mixed", "other"] },
        "url": { "type": ["string", "null"] },
        "steps": { "type": "array", "items": { "type": "string" } },
        "note": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "role": { "type": ["string", "null"] },
          "email": { "type": ["string", "null"] },
          "phone": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "ref": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "meta": {
      "type": "object",
      "required": ["last_verified", "status"],
      "additionalProperties": false,
      "properties": {
        "last_verified": { "type": "string", "format": "date" },
        "verified_by": { "type": ["string", "null"] },
        "status": { "enum": ["draft", "verified"] },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["source_id"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string" },
        "locator": { "type": ["string", "null"], "description": "Randnummer, Ziffer, Artikel oder Seite, z. B. 'N 20' oder 'Ziff. 3.7'" }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "title", "type", "url", "checked"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "enum": ["handbuch", "verordnung", "gesetz", "merkblatt", "webseite", "faq", "formular", "praesentation"] },
        "url": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "published": { "type": ["string", "null"], "format": "date" },
        "checked": { "type": "string", "format": "date" },
        "local_path": { "type": ["string", "null"] }
      }
    },
    "textWithSource": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "source": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["id", "text", "kind", "about"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "text": { "type": "string" },
        "kind": {
          "enum": ["muss", "soll", "bewertung"],
          "description": "muss = Ausschlusskriterium; soll = Vorteil oder Einzelfallentscheid; bewertung = Qualitätskriterium in kompetitiver Auswahl"
        },
        "about": { "enum": ["unternehmen", "vorhaben", "kosten", "zeit", "partner", "ort", "dokumente", "objekt"] },
        "applies_if": { "type": ["string", "null"], "description": "Bedingung, falls das Kriterium nur manchmal gilt, z. B. 'nur bei Auftragsforschung'" },
        "profile_fields": { "type": "array", "items": { "type": "string" }, "description": "Felder im Projektprofil, die dieses Kriterium beantworten" },
        "question": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string" },
            "options": { "type": "array", "items": { "type": "string" } }
          }
        },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/sourceRef" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "eligibleItem": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "definition": { "type": ["string", "null"] },
        "examples_positive": { "type": "array", "items": { "type": "string" } },
        "examples_negative": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "document": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "condition": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "lever": {
      "type": "object",
      "required": ["text", "affects_criteria"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "affects_criteria": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "combinationRule": {
      "type": "object",
      "required": ["with", "type", "text"],
      "additionalProperties": false,
      "properties": {
        "with": { "type": "string", "description": "Programm-ID, 'programm-id:instrument-id' oder '*' für alle" },
        "type": { "enum": ["abzug", "ausgeschlossen", "erlaubt", "bedingt"] },
        "text": { "type": "string" },
        "source": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "instrument": {
      "type": "object",
      "required": ["id", "name", "instrument_type", "recipient", "filter", "criteria", "funding", "timing"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "instrument_type": { "enum": ["beitrag", "steuergutschrift", "gutschrift", "darlehen", "buergschaft", "beratung", "coaching", "stipendium", "sonstiges"] },
        "recipient": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["gesuchsteller", "forschungspartner", "dienstleister"] },
            "note": { "type": ["string", "null"] }
          }
        },
        "filter": {
          "type": "object",
          "description": "Harte, maschinenlesbare Merkmale für den Vorfilter im Code",
          "required": ["applicant_types", "project_types"],
          "additionalProperties": false,
          "properties": {
            "applicant_types": {
              "type": "array",
              "items": { "enum": ["unternehmen", "startup", "kmu", "grossunternehmen", "eigentuemer", "gemeinde", "verein_stiftung", "forschungsinstitution", "privatperson"] }
            },
            "employees_min": { "type": ["integer", "null"] },
            "employees_max": { "type": ["integer", "null"] },
            "company_age_years_max": { "type": ["integer", "null"] },
            "requires_partner": { "enum": ["keiner", "forschungspartner", "umsetzungspartner"] },
            "project_types": {
              "type": "array",
              "items": {
                "enum": [
                  "forschung", "entwicklung", "prototyp", "machbarkeitsstudie", "prozessinnovation", "organisationsinnovation",
                  "klinische_studie", "gebaeudesanierung", "heizungsersatz", "erneuerbare_energie", "energieeffizienz",
                  "e_mobilitaet", "nachhaltiges_bauen", "export", "tourismus", "gruendung", "wachstum",
                  "regionalentwicklung", "digitalisierung", "weiterbildung", "finanzierung", "kultur", "soziales"
                ]
              }
            }
          }
        },
        "eligible_items": { "type": "array", "items": { "$ref": "#/$defs/eligibleItem" } },
        "exclusions": { "type": "array", "items": { "$ref": "#/$defs/textWithSource" } },
        "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
        "funding": {
          "type": "object",
          "required": ["model", "summary"],
          "additionalProperties": false,
          "properties": {
            "model": { "enum": ["prozent_kosten", "pauschal", "pro_einheit", "gestaffelt", "gutschrift", "kostenbeteiligung", "individuell"] },
            "summary": { "type": "string" },
            "cost_categories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "rate_pct": { "type": ["number", "null"] },
                  "definition": { "type": ["string", "null"] },
                  "source": { "$ref": "#/$defs/sourceRef" }
                }
              }
            },
            "units": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["unit"],
                "additionalProperties": false,
                "properties": {
                  "unit": { "type": "string" },
                  "condition": { "type": ["string", "null"] },
                  "base_chf": { "type": ["number", "null"] },
                  "amount_chf": { "type": ["number", "null"] }
                }
              }
            },
            "max_share_of_costs_pct": { "type": ["number", "null"] },
            "min_amount_chf": { "type": ["number", "null"] },
            "max_amount_chf": { "type": ["number", "null"] },
            "cofinancing": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "required": { "type": "boolean" },
                "rule": { "type": ["string", "null"] }
              }
            },
            "deductions": { "type": "array", "items": { "$ref": "#/$defs/textWithSource" } },
            "payout_forms": { "type": "array", "items": { "type": "string" } },
            "calculation_basis": { "type": ["string", "null"] },
            "example": { "type": ["string", "null"] },
            "source": { "$ref": "#/$defs/sourceRef" }
          }
        },
        "timing": {
          "type": "object",
          "required": ["deadline"],
          "additionalProperties": false,
          "properties": {
            "deadline": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["fester_termin_jaehrlich", "fester_termin", "laufend", "vor_projektstart", "nach_abschluss", "ausschreibung", "unbekannt"] },
                "rule": { "type": ["string", "null"] },
                "next_dates": { "type": "array", "items": { "type": "string", "format": "date" } },
                "relative": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "properties": {
                    "event": { "enum": ["projektstart", "baubeginn", "installationsbeginn", "inbetriebnahme", "publikation", "gruendung"] },
                    "direction": { "enum": ["vor", "nach"] },
                    "offset_days": { "type": ["integer", "null"] }
                  }
                },
                "source": { "$ref": "#/$defs/sourceRef" }
              }
            },
            "assessment_period": { "type": ["string", "null"] },
            "decision_time": { "type": ["string", "null"] },
            "max_duration_months": { "type": ["integer", "null"] },
            "repeat_limit": { "type": ["string", "null"] },
            "note": { "type": ["string", "null"] }
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "application": { "type": "array", "items": { "$ref": "#/$defs/document" } },
            "completion": { "type": "array", "items": { "$ref": "#/$defs/document" } }
          }
        },
        "obligations": { "type": "array", "items": { "$ref": "#/$defs/textWithSource" } },
        "levers": { "type": "array", "items": { "$ref": "#/$defs/lever" } },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "info": { "type": ["string", "null"] },
            "apply": { "type": ["string", "null"] },
            "form": { "type": ["string", "null"] }
          }
        },
        "source": { "$ref": "#/$defs/sourceRef" }
      }
    }
  }
}
